# --- Backend Configuration ---
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# Credentials for the initial admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# --- Web Push (VAPID) ---
# Contact email for push service providers
VAPID_SUBJECT=mailto:your-email@example.com

# Generate these using 'make vapid-gen'
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here

# --- Database ---
# Default for SQLite inside Docker
DATABASE_URL=sqlite:///data/habits.db
